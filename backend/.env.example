# AnkiConnect URL (default: http://localhost:8765)
ANKI_CONNECT_URL=http://localhost:8765

# Google Gemini API Key (required for AI field generation)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Google Cloud TTS (optional, for audio generation)
# Path to service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# AI Monthly Cost Limit in USD (default: 1.0)
AI_MONTHLY_LIMIT=1.0
